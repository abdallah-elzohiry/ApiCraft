{
    "openapi": "3.0.3",
    "info": {
        "title": "Users API",
        "version": "1.0.0"
    },
    "paths": {
        "/users": {
            "get": {
                "operationId": "getUsers",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/UserDto"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "UserDto": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "address": {
                        "$ref": "#/components/schemas/AddressDto"
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/RoleDto"
                        }
                    }
                }
            },
            "AddressDto": {
                "type": "object",
                "required": [
                    "city"
                ],
                "properties": {
                    "city": {
                        "type": "string"
                    }
                }
            },
            "RoleDto": {
                "type": "object",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    }
                }
            }
        }
    }
}