{
  "name": "codexa",
  "version": "0.1.0",
  "description": "Code generation toolkit for OpenAPI-based APIs",
  "type": "module",
  "bin": {
    "codexa": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "openapi",
    "swagger",
    "code-generator",
    "typescript",
    "angular",
    "api-client"
  ],
  "author": "CodeXA",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "commander": "^15.0.0",
    "openapi-types": "^12.1.3"
  }
}